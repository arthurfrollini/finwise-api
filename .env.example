DATABASE_URL=""
JWT_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PLATINUM=
REDIS_HOST=
REDIS_PORT=
ANTHROPIC_API_KEY=

# Optional — rate limits per route and client IP, per minute (defaults 100 / 5 / 10).
# TRUST_PROXY=1 behind a hosting proxy, so the client IP (not the proxy's) is the key.
THROTTLE_DEFAULT_LIMIT=
THROTTLE_AUTH_LIMIT=
THROTTLE_AI_LIMIT=
TRUST_PROXY=

# Optional — global ceiling on Claude spend per UTC day, all users (default 1).
AI_DAILY_SPEND_LIMIT_USD=

# Optional — BILLING_ENABLED=false turns off the self-service /billing routes
# (404) while keeping the Stripe webhook; production runs Stripe in test mode.
BILLING_ENABLED=

# Optional — mail. MAIL_REDIRECT_TO sends every email to one inbox (local dev);
# MAIL_ENABLED=false skips sending entirely (production without a verified domain).
MAIL_REDIRECT_TO=
MAIL_ENABLED=

# Optional — Grafana alert emails (docker-compose grafana service). ALERT_EMAIL
# is who gets them; empty keeps alerts quiet (docker-compose then points the
# contact point at an address that never receives mail). ALERT_FROM_EMAIL must
# be a sender Resend accepts (onboarding@resend.dev until a domain is verified,
# which only delivers to the Resend account's own address).
ALERT_EMAIL=
ALERT_FROM_EMAIL=

# Optional — BullMQ key prefix. .env.test sets bull-test so the e2e suite never
# shares queues with a dev API running at the same time.
BULLMQ_PREFIX=

# Optional — observability, both already default to the local Docker services
OTEL_EXPORTER_OTLP_ENDPOINT=
LOKI_URL=